<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The puppet HTTP server binds only 127.0.0.1, but Android's sandbox
         still requires INTERNET to create *any* socket — including
         listening sockets on localhost. Without this permission Ktor
         throws "java.net.SocketException: Operation not permitted" at
         server start. Cleartext is fine for localhost traffic. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="maxe explorer"
        android:supportsRtl="true"
        android:theme="@style/Theme.aMazeGame"
        tools:targetApi="31"
        xmlns:tools="http://schemas.android.com/tools">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Puppet HTTP server runs in the same process as the Activity;
             a separate service can be added later if we want it to outlive
             the foreground UI. -->
    </application>

</manifest>
