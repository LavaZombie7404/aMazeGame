<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The puppet HTTP server only binds 127.0.0.1; no INTERNET permission
         is needed because it doesn't make outbound calls. Localhost binding
         is exempt from cleartext-traffic restrictions on modern Android. -->

    <application
        android:allowBackup="true"
        android:label="aMazeGame"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        tools:targetApi="31"
        xmlns:tools="http://schemas.android.com/tools">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Puppet HTTP server runs in the same process as the Activity;
             a separate service can be added later if we want it to outlive
             the foreground UI. -->
    </application>

</manifest>
