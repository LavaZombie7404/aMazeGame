{
  "name": "amazegame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "core:build": "node scripts/build-core.mjs",
    "dev": "npm run core:build && vite --host 0.0.0.0",
    "build": "npm run core:build && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.2",
    "@types/sql.js": "^1.4.11",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "sql.js": "^1.11.0"
  }
}
